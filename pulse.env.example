# Impostazioni personali di Pulse.
# Copia questo file come "pulse.env" (nella stessa cartella) e scrivi i tuoi dati dopo il "=".
# pulse.env non viene mai sovrascritto dagli aggiornamenti e non va pubblicato su GitHub.

# Titolare del trattamento dei dati: il tuo nome e cognome, oppure il nome della tua società/associazione
PULSE_CONTROLLER_NAME=Nome Cognome

# Email a cui gli utenti scrivono per privacy e segnalazioni (meglio un indirizzo dedicato)
PULSE_CONTACT_EMAIL=privacy@esempio.it

# Link al codice pubblico su GitHub (lascia vuoto finché non c'è)
PULSE_SOURCE_URL=

# Quanti sostenitori servono perché una proposta diventi un sondaggio (predefinito 20).
# Per provare in locale con pochi account puoi mettere 3.
# PULSE_PROPOSAL_GOAL=20
